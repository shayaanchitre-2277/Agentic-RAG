# ==============================================================================
# Agentic RAG .gitignore
# ==============================================================================

# Environment variables & local secrets
.env
.env.*
!.env.example

# Python virtual environment (root & nested)
.venv/
backend/.venv/
env/
venv/
ENV/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node.js & Supabase CLI artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Project-local caches & temporary directories on E: drive
.cache/
.tmp/
.npm-cache/

# Credentials, tokens, and OAuth secrets
credentials/
token.json
client_secrets*.json
*.pem
*.key

# Supabase local ephemeral runtime files & secrets
supabase/.branches/
supabase/.temp/
supabase/.temp/*

# OS specific files
Thumbs.db
[Dd]esktop.ini
.DS_Store
