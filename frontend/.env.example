# ==============================================================================
# Frontend Environment Configuration (.env.example)
#
# Safe local placeholders for Vite + React client.
# BROWSER KEY ISOLATION:
#   ONLY VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, and VITE_API_BASE_URL
#   are allowed in the frontend.
#   NEVER put SUPABASE_SERVICE_ROLE_KEY or LLM keys here.
# ==============================================================================

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=placeholder-local-anon-key
VITE_API_BASE_URL=http://127.0.0.1:8000
