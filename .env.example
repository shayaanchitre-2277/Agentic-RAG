# ==============================================================================
# Agentic RAG Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Do NOT put actual secrets, API keys, or credentials in this file.
# - Copy this file to .env and supply your local development values.
# - The .env file is gitignored to prevent accidental credential leakage.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. External Connectors & Sandboxes (Phase 0 & Phase 4)
# ------------------------------------------------------------------------------

# Notion API Integration Token
# Generated in Notion Integrations settings; shared with 'Agentic RAG Sandbox' page
NOTION_API_KEY=secret_notion_api_token_placeholder

# Jira Cloud Integration
# Base URL of your Atlassian Jira Cloud sandbox (e.g. https://your-domain.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net
# Account email associated with the Jira API token
JIRA_USER_EMAIL=user@example.com
# Jira Cloud API token created in Atlassian account security settings
JIRA_API_TOKEN=jira_api_token_placeholder

# Google OAuth 2.0 (Gmail / Drive)
# Path to downloaded Google Desktop OAuth client secret file (relative to root)
GMAIL_CLIENT_SECRETS_FILE=credentials/gmail_oauth_client.json
# Path where the user's authorized OAuth token will be persisted
GMAIL_TOKEN_FILE=credentials/token.json

# ------------------------------------------------------------------------------
# 2. LLM Providers & Observability (Phase 1, Phase 3)
# ------------------------------------------------------------------------------

# Gemini API (Primary LLM Provider)
GEMINI_API_KEY=gemini_api_key_placeholder

# OpenAI API (Secondary Provider, Evaluations & Judge Role)
OPENAI_API_KEY=sk-openai_api_key_placeholder

# Hugging Face (Model Hub & Evaluation Token)
HF_TOKEN=hf_read_token_placeholder

# Langfuse Observability & LLM Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 3. Supabase Platform & Database (Phase 1+)
# ------------------------------------------------------------------------------

# Supabase Project API URL (Local default: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anonymous Client Key (Browser & public client requests)
SUPABASE_ANON_KEY=supabase_anon_key_placeholder

# Supabase Service Role Key (Background jobs / administrative migrations only - NEVER in request paths)
SUPABASE_SERVICE_ROLE_KEY=supabase_service_role_key_placeholder

# Supabase JWT Secret / Verification configuration
SUPABASE_JWT_SECRET=supabase_jwt_secret_placeholder
SUPABASE_JWT_ALGORITHM=HS256
# Optional JWKS URL for asymmetric verification (overrides SUPABASE_JWT_SECRET if set)
# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Direct PostgreSQL Database URL (For LangGraph checkpointer / Alembic / Prisma if applicable)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# 4. Application Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
